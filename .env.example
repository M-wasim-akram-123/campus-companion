# Copy to .env and fill in from YOUR Supabase project (Settings → API)
# https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_public_key

# CRITICAL SECURITY: Server-side admin key (bypasses ALL RLS)
# NEVER commit the real SUPABASE_SERVICE_ROLE_KEY to git
# After removing .env from git, ROTATE this key in Supabase dashboard
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Auto-voucher webhook authentication
# Generate a strong random secret for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set this in Vercel environment variables
# Webhook callers must send this in x-auto-vouchers-secret header
AUTO_VOUCHERS_SECRET=your_random_secret_here

# Campus branding (optional)
# VITE_CAMPUS_NAME="Your Institution Name"
# VITE_CAMPUS_TAGLINE="Your Tagline"
# VITE_CAMPUS_ADDRESS="Your Address"
# VITE_CAMPUS_LOGO_URL="/logo.png"
